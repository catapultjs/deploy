{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catapultjs.com/schema/deploy.schema.json",
  "title": "Catapult deploy JSON configuration",
  "description": "Declarative deployment configuration for @catapultjs/deploy.",
  "type": "object",
  "required": ["version", "config"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "recipes": {
      "type": "array",
      "items": {
        "enum": [
          "adonisjs",
          "adonisjs_local",
          "astro",
          "astro_static",
          "caddy",
          "compose",
          "container",
          "directus",
          "git",
          "nestjs",
          "nextjs",
          "nextjs_local",
          "nextjs_static",
          "nuxt",
          "nuxt_static",
          "pm2",
          "quadlet",
          "redis",
          "rsync",
          "systemd",
          "tanstack",
          "vitepress"
        ]
      },
      "uniqueItems": true
    },
    "config": { "$ref": "#/definitions/config" },
    "store": { "$ref": "#/definitions/store" },
    "tasks": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
      "additionalProperties": { "$ref": "#/definitions/taskDefinition" }
    },
    "pipeline": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
      "minItems": 1,
      "uniqueItems": true
    },
    "before": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
          {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
            "minItems": 1,
            "uniqueItems": true
          }
        ]
      }
    },
    "after": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
          {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
            "minItems": 1,
            "uniqueItems": true
          }
        ]
      }
    },
    "remove": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
      "uniqueItems": true
    }
  },
  "definitions": {
    "store": {
      "type": "object",
      "properties": {
        "shared_dirs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "shared_files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "writable_dirs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "source_path": { "type": "string" },
        "adonisjs_path": { "type": "string" },
        "astro_mode": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "type": "string", "minLength": 1 },
              "additionalProperties": { "type": "string", "minLength": 1 }
            }
          ]
        },
        "astro_path": { "type": "string" },
        "caddy_config_path": { "type": "string", "minLength": 1 },
        "caddy_local_config_path": { "type": "string", "minLength": 1 },
        "caddy_upload_path": { "type": "string", "minLength": 1 },
        "caddy_use_sudo": { "type": "boolean" },
        "caddy_validate_before_reload": { "type": "boolean" },
        "compose_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "compose_image_services": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$" }
        },
        "compose_logs_lines": { "type": "number", "exclusiveMinimum": 0 },
        "compose_migrate": {
          "type": "object",
          "properties": {
            "service": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$" },
            "command": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          },
          "required": ["service", "command"],
          "additionalProperties": false
        },
        "compose_profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$" }
        },
        "compose_remove_orphans": { "type": "boolean" },
        "compose_services": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$" }
        },
        "compose_upload": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "compose_wait_timeout": { "type": "number", "exclusiveMinimum": 0 },
        "container_build": {
          "type": "object",
          "properties": {
            "file": { "type": "string", "minLength": 1 },
            "context": { "type": "string", "minLength": 1 },
            "target": { "type": "string", "minLength": 1 },
            "platform": { "type": "string", "minLength": 1 },
            "args": {
              "type": "object",
              "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "additionalProperties": { "type": "string" }
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "container_build_engine": { "enum": ["docker", "podman"] },
        "container_compression": { "enum": ["none", "gzip", "zstd"] },
        "container_engine": { "enum": ["docker", "podman"] },
        "container_image": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
        "container_keep_local": { "type": "integer", "minimum": 1 },
        "container_logs_lines": { "type": "number", "exclusiveMinimum": 0 },
        "container_migrate": {
          "type": "object",
          "properties": {
            "service": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$" },
            "command": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          },
          "required": ["service", "command"],
          "additionalProperties": false
        },
        "container_registry": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*(?::\\d+)?(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)+$"
            },
            "auth": {
              "type": "object",
              "properties": {
                "username_env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
                "password_env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
              },
              "required": ["username_env", "password_env"],
              "additionalProperties": false
            }
          },
          "required": ["repository"],
          "additionalProperties": false
        },
        "container_project": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "container_services": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$" },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "init": { "type": "boolean" },
              "healthcheck": {
                "oneOf": [
                  { "type": "boolean" },
                  {
                    "type": "object",
                    "properties": {
                      "cmd": { "type": "string", "minLength": 1 },
                      "interval": { "type": "string", "pattern": "^(\\d+(ns|us|ms|s|m|h))+$" },
                      "timeout": { "type": "string", "pattern": "^(\\d+(ns|us|ms|s|m|h))+$" },
                      "retries": { "type": "integer", "minimum": 1 },
                      "start_period": { "type": "string", "pattern": "^(\\d+(ns|us|ms|s|m|h))+$" }
                    },
                    "required": ["cmd"],
                    "additionalProperties": false
                  }
                ]
              },
              "entrypoint": { "type": "string", "minLength": 1 },
              "user": { "type": "string", "minLength": 1 },
              "env": {
                "type": "object",
                "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
                "additionalProperties": { "type": "string" }
              },
              "env_file": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "ports": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "volumes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "restart": {
                "type": "string",
                "pattern": "^(no|always|unless-stopped|on-failure(:\\d+)?)$"
              },
              "labels": { "type": "object", "additionalProperties": { "type": "string" } },
              "memory": { "type": "string", "pattern": "^\\d+(\\.\\d+)?[bkmgBKMG]?$" },
              "cpus": {
                "oneOf": [
                  { "type": "number", "exclusiveMinimum": 0 },
                  { "type": "string", "pattern": "^\\d+(\\.\\d+)?$" }
                ]
              },
              "networks": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$" }
              },
              "options": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            },
            "additionalProperties": false
          }
        },
        "container_source": { "type": "string", "minLength": 1 },
        "container_stop_timeout": { "type": "number", "exclusiveMinimum": 0 },
        "container_transfer": { "enum": ["ssh", "registry"] },
        "container_wait_timeout": { "type": "number", "exclusiveMinimum": 0 },
        "directus_path": { "type": "string" },
        "directus_snapshot_path": { "type": "string", "minLength": 1 },
        "nextjs_path": { "type": "string" },
        "nextjs_out_path": { "type": "string", "minLength": 1 },
        "nextjs_server_path": { "type": "string", "minLength": 1 },
        "nextjs_upload_archive": { "type": "boolean" },
        "nuxt_path": { "type": "string" },
        "quadlet_logs_lines": { "type": "number", "exclusiveMinimum": 0 },
        "quadlet_path": { "type": "string", "minLength": 1 },
        "quadlet_wait_timeout": { "type": "number", "exclusiveMinimum": 0 },
        "redis_db": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            {
              "type": "array",
              "items": { "type": "integer", "minimum": 0 },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        },
        "rsync_source_path": { "type": "string", "minLength": 1 },
        "rsync_excludes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "systemd_service": { "type": "string", "minLength": 1 },
        "systemd_services": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "systemd_unit_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "\\.service$" }
        },
        "systemd_use_sudo": { "type": "boolean" },
        "systemd_logs_lines": { "type": "number", "exclusiveMinimum": 0 },
        "vitepress_path": { "type": "string" }
      },
      "required": [],
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "properties": {
        "keepReleases": { "type": "integer", "minimum": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "packageManager": { "enum": ["npm", "pnpm", "yarn", "bun"] },
        "hosts": { "type": "array", "items": { "$ref": "#/definitions/host" }, "minItems": 1 },
        "verbose": { "enum": [0, 1, 2, 3] }
      },
      "required": ["hosts"],
      "additionalProperties": false
    },
    "host": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "ssh": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "object",
              "properties": {
                "user": { "type": "string", "minLength": 1 },
                "host": { "type": "string", "minLength": 1 },
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "identityFile": { "type": "string", "minLength": 1 }
              },
              "required": ["user", "host"],
              "additionalProperties": false
            }
          ]
        },
        "deployPath": { "type": "string", "minLength": 1, "pattern": "^/" },
        "branch": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "object",
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "ask": { "type": "boolean" }
              },
              "required": ["name", "ask"],
              "additionalProperties": false
            }
          ]
        },
        "healthcheck": {
          "type": "object",
          "properties": {
            "url": { "type": "string", "minLength": 1 },
            "retries": { "type": "integer", "minimum": 1 },
            "delayMs": { "type": "integer", "minimum": 0 }
          },
          "required": [],
          "additionalProperties": false
        },
        "bin": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "multiplexing": { "type": "boolean" }
      },
      "required": ["name", "ssh", "deployPath"],
      "additionalProperties": false
    },
    "taskStep": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "cd": { "type": "string", "minLength": 1 } },
          "required": ["cd"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "run": { "type": "string", "minLength": 1 } },
          "required": ["run"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "local": {
              "type": "object",
              "properties": {
                "command": { "type": "string", "minLength": 1 },
                "cwd": { "type": "string", "minLength": 1 }
              },
              "required": ["command"],
              "additionalProperties": false
            }
          },
          "required": ["local"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "upload": {
              "type": "object",
              "properties": {
                "local": { "type": "string", "minLength": 1 },
                "remote": { "type": "string", "minLength": 1 }
              },
              "required": ["local", "remote"],
              "additionalProperties": false
            }
          },
          "required": ["upload"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "download": {
              "type": "object",
              "properties": {
                "remote": { "type": "string", "minLength": 1 },
                "local": { "type": "string", "minLength": 1 }
              },
              "required": ["remote", "local"],
              "additionalProperties": false
            }
          },
          "required": ["download"],
          "additionalProperties": false
        }
      ]
    },
    "taskDefinition": {
      "oneOf": [
        { "type": "array", "items": { "$ref": "#/definitions/taskStep" }, "minItems": 1 },
        {
          "type": "object",
          "properties": {
            "description": { "type": "string", "minLength": 1 },
            "steps": {
              "type": "array",
              "items": { "$ref": "#/definitions/taskStep" },
              "minItems": 1
            }
          },
          "required": ["steps"],
          "additionalProperties": false
        }
      ]
    }
  }
}
